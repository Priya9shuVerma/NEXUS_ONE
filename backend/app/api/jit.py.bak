from datetime import datetime, timedelta

from fastapi import APIRouter, Depends, HTTPException
from sqlalchemy.orm import Session

from app.core.dependencies import get_current_user, get_current_admin
from app.db.database import get_db
from app.models.iam import IAMRole, JITAccessRequest, user_roles
from app.models.user import User


router = APIRouter(
    prefix="/iam/jit",
    tags=["IAM - JIT"],
)


@router.post("/request")
def request_jit_access(
    role_id: int,
    reason: str,
    duration_minutes: int = 60,
    current_user: User = Depends(get_current_user),
    db: Session = Depends(get_db),
):
    if not current_user.is_active:
        raise HTTPException(status_code=403, detail="Inactive user")

    if duration_minutes < 5 or duration_minutes > 1440:
        raise HTTPException(
            status_code=400,
            detail="Duration must be between 5 and 1440 minutes",
        )

    role = (
        db.query(IAMRole)
        .filter(
            IAMRole.id == role_id,
            IAMRole.is_active.is_(True),
        )
        .first()
    )

    if not role:
        raise HTTPException(status_code=404, detail="Role not found")

    pending = (
        db.query(JITAccessRequest)
        .filter(
            JITAccessRequest.user_id == current_user.id,
            JITAccessRequest.role_id == role_id,
            JITAccessRequest.status == "pending",
        )
        .first()
    )

    if pending:
        raise HTTPException(
            status_code=400,
            detail="A pending JIT request already exists",
        )

    request = JITAccessRequest(
        user_id=current_user.id,
        role_id=role.id,
        reason=reason,
        status="pending",
        expires_at=datetime.utcnow()
        + timedelta(minutes=duration_minutes),
    )

    db.add(request)
    db.commit()
    db.refresh(request)

    return {
        "message": "JIT access request submitted",
        "request_id": request.id,
        "role_id": request.role_id,
        "role": role.name,
        "status": request.status,
        "expires_at": request.expires_at,
    }


@router.get("/requests")
def get_jit_requests(
    current_admin: User = Depends(get_current_admin),
    db: Session = Depends(get_db),
):
    requests = (
        db.query(JITAccessRequest)
        .order_by(JITAccessRequest.created_at.desc())
        .all()
    )

    return [
        {
            "id": request.id,
            "user_id": request.user_id,
            "role_id": request.role_id,
            "reason": request.reason,
            "status": request.status,
            "expires_at": request.expires_at,
            "approved_by": request.approved_by,
            "created_at": request.created_at,
        }
        for request in requests
    ]


@router.post("/approve/{request_id}")
def approve_jit_access(
    request_id: int,
    current_admin: User = Depends(get_current_admin),
    db: Session = Depends(get_db),
):
    request = (
        db.query(JITAccessRequest)
        .filter(JITAccessRequest.id == request_id)
        .first()
    )

    if not request:
        raise HTTPException(
            status_code=404,
            detail="JIT request not found",
        )

    if request.status != "pending":
        raise HTTPException(
            status_code=400,
            detail=f"Request is already {request.status}",
        )

    if request.expires_at and request.expires_at <= datetime.utcnow():
        request.status = "expired"
        db.commit()

        raise HTTPException(
            status_code=400,
            detail="JIT request has expired",
        )

    role = (
        db.query(IAMRole)
        .filter(IAMRole.id == request.role_id)
        .first()
    )

    if not role:
        raise HTTPException(
            status_code=404,
            detail="Role not found",
        )

    existing = db.execute(
        user_roles.select().where(
            user_roles.c.user_id == request.user_id,
            user_roles.c.role_id == request.role_id,
        )
    ).first()

    if not existing:
        db.execute(
            user_roles.insert().values(
                user_id=request.user_id,
                role_id=request.role_id,
            )
        )

    request.status = "approved"
    request.approved_by = current_admin.id

    db.commit()

    return {
        "message": "JIT access approved",
        "request_id": request.id,
        "user_id": request.user_id,
        "role": role.name,
        "status": request.status,
        "expires_at": request.expires_at,
    }


@router.post("/reject/{request_id}")
def reject_jit_access(
    request_id: int,
    current_admin: User = Depends(get_current_admin),
    db: Session = Depends(get_db),
):
    request = (
        db.query(JITAccessRequest)
        .filter(JITAccessRequest.id == request_id)
        .first()
    )

    if not request:
        raise HTTPException(
            status_code=404,
            detail="JIT request not found",
        )

    if request.status != "pending":
        raise HTTPException(
            status_code=400,
            detail=f"Request is already {request.status}",
        )

    request.status = "rejected"
    request.approved_by = current_admin.id

    db.commit()

    return {
        "message": "JIT access rejected",
        "request_id": request.id,
        "status": request.status,
    }


@router.post("/revoke/{request_id}")
def revoke_jit_access(
    request_id: int,
    current_admin: User = Depends(get_current_admin),
    db: Session = Depends(get_db),
):
    request = (
        db.query(JITAccessRequest)
        .filter(JITAccessRequest.id == request_id)
        .first()
    )

    if not request:
        raise HTTPException(
            status_code=404,
            detail="JIT request not found",
        )

    db.execute(
        user_roles.delete().where(
            user_roles.c.user_id == request.user_id,
            user_roles.c.role_id == request.role_id,
        )
    )

    request.status = "revoked"

    db.commit()

    return {
        "message": "JIT access revoked",
        "request_id": request.id,
        "status": request.status,
    }
